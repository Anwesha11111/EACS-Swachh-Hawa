# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.
# All keys below are OPTIONAL — the app runs fully on mock/seed data without them.

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret for signing session tokens (HMAC-SHA256). Any random 32-char string.
AUTH_SECRET=replace_with_32_char_random_secret

# ── AQI data (data.gov.in CPCB) ──────────────────────────────────────────────
# Server-only. Without this, jittered CITIES mock data is used.
AQI_API_KEY=your_datagov_api_key_here

# ── Weather (OpenWeatherMap or compatible) ────────────────────────────────────
# Server-only. Without this, IMD seed data (src/lib/data/imd-weather.ts) is used.
WEATHER_API_KEY=your_openweathermap_api_key_here

# ── AirGPT — Claude/Anthropic ────────────────────────────────────────────────
# Server-only. Without this, rule-based responder uses CPCB/IMD data.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-haiku-4-5-20251001

# ── SMS alerts (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+91xxxxxxxxxx

# ── Email alerts (SendGrid) ───────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@swachhhawa.gov.in

# ── Push notifications (FCM) ──────────────────────────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key_here

# ── Supabase (Phase 4 — persistence) ─────────────────────────────────────────
# Server-only service-role key (never expose to client).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Client-safe anon key (ships to browser, read-only ACLs only).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Public config ─────────────────────────────────────────────────────────────
VITE_MAP_TILE_KEY=your_maptiler_or_mapbox_key_here
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
