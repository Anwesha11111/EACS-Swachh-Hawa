# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real secrets.

# CPCB / AQI data API
VITE_AQI_API_KEY=your_cpcb_api_key_here
VITE_AQI_API_BASE_URL=https://api.data.gov.in/resource

# Map tiles (if using a tile provider)
VITE_MAP_TILE_KEY=your_maptiler_or_mapbox_key_here

# Analytics / monitoring (optional)
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
